---
import { type Locale, getTranslations } from '../i18n';
import { url } from '../url';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Logo from './Logo.astro';
import Icon from './Icon.astro';

const { locale } = Astro.props as { locale: Locale };
const t = getTranslations(locale);
const instagram =
  'https://www.instagram.com/koko_recovery?stkn=MWVoanUxcmNqZGQwZg%3D%3D&utm_source=qr';
const navLinks = ['skills', 'management', 'sneakers', 'restoration'];
---

<header class="header">
  <div class="container header__inner">
    <button
      class="header__mobile-toggle"
      aria-label={t.menu}
      aria-expanded="false"
      data-menu-button
    >
      <svg
        class="header__mobile-icon"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        data-menu-icon
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.5"
          d="M4 6h16M4 12h16M4 18h16"></path></svg
      >
      <svg
        class="header__mobile-icon header__mobile-icon--close"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        data-menu-icon-close
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.5"
          d="M6 6l12 12M18 6l-12 12"></path></svg
      >
    </button>
    <Logo locale={locale} />
    <nav class="nav-desktop" aria-label={t.navigation}>
      {
        navLinks.map((id, index) => (
          <a href={`#${id}`} class="nav-desktop__link gold-hover-link">
            {t.nav[index]}
          </a>
        ))
      }
    </nav>
    <div class="header__actions-group">
      <LanguageSwitcher locale={locale} />
    </div>
  </div>
  <div class="mobile-menu hidden" data-mobile-menu>
    <div class="mobile-menu__nav">
      {
        navLinks.map((id, index) => (
          <a href={`#${id}`} class="mobile-menu__link">
            {t.nav[index]}
          </a>
        ))
      }
    </div>
    <div class="mobile-menu__footer">
      <a
        href={instagram}
        target="_blank"
        rel="noopener noreferrer"
        class="mobile-menu__instagram"
      >
        <Icon id="instagram" width={20} height={20} /> Koko recovery
      </a>
    </div>
  </div>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 50;
    background: var(--color-white-alpha-88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-gray-200-alpha-60);
    transition: all var(--transition-fast);
  }

  .header__inner {
    display: flex;
    justify-content: space-between;
    height: var(--header-height);
    align-items: center;
  }

  .header__actions-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .nav-desktop {
    display: none;
    align-items: center;
    gap: 2rem;
  }

  .nav-desktop__link {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-weight: 500;
    color: var(--color-dark);
  }

  .header__actions {
    display: none;
    align-items: center;
    gap: 1.25rem;
  }

  .header__instagram {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-dark);
    display: flex;
    align-items: center;
    gap: 0.375rem;
    transition: color var(--transition-fast);
  }

  .header__instagram:hover {
    color: var(--color-gold);
  }

  .header__instagram-icon {
    width: 1rem;
    height: 1rem;
    fill: currentColor;
    color: var(--color-gold);
  }

  .header__mobile-toggle {
    display: inline-flex;
    padding: 0.5rem;
    color: var(--color-dark);
  }

  .header__mobile-toggle:focus {
    outline: none;
  }

  .header__mobile-icon {
    width: 1.5rem;
    height: 1.5rem;
  }

  .header__mobile-icon--close {
    display: none;
  }

  .header__mobile-toggle[aria-expanded='true'] .header__mobile-icon {
    display: none;
  }

  .header__mobile-toggle[aria-expanded='true'] .header__mobile-icon--close {
    display: block;
  }

  .mobile-menu {
    display: none;
    background-color: var(--color-white);
    border-bottom: 1px solid var(--color-gray-200);
    padding: 1.5rem;
  }

  .mobile-menu:not(.hidden) {
    display: block;
  }

  .mobile-menu__nav {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .mobile-menu__link {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 500;
    color: var(--color-dark);
    padding-top: 0.25rem;
    padding-bottom: 0.25rem;
    display: block;
  }

  .mobile-menu__link:hover {
    color: var(--color-gold);
  }

  .mobile-menu__footer {
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-gray-100);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .mobile-menu__instagram {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-gold);
    font-weight: 600;
    text-decoration: none;
  }

  .mobile-menu__instagram svg {
    flex-shrink: 0;
  }

  @media (min-width: 640px) {
    .header__actions {
      display: flex;
    }
  }

  @media (min-width: 1024px) {
    .header__inner {
      display: flex;
      justify-content: space-between;
    }

    .nav-desktop {
      display: flex;
    }

    .header__mobile-toggle {
      display: none;
    }

    .mobile-menu {
      display: none !important;
    }
  }
</style>

<script is:inline>
  const menuButton = document.querySelector('[data-menu-button]');
  const mobileMenu = document.querySelector('[data-mobile-menu]');
  const menuIcon = document.querySelector('[data-menu-icon]');
  const menuIconClose = document.querySelector('[data-menu-icon-close]');
  menuButton?.addEventListener('click', () => {
    const open = mobileMenu.classList.toggle('hidden') === false;
    menuButton.setAttribute('aria-expanded', String(open));
    menuButton.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    menuIcon.classList.toggle('hidden', open);
    menuIconClose.classList.toggle('hidden', !open);
  });
  mobileMenu?.querySelectorAll('a').forEach((link) =>
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      menuButton.setAttribute('aria-expanded', 'false');
      menuButton.setAttribute('aria-label', 'Open menu');
      menuIcon.classList.remove('hidden');
      menuIconClose.classList.add('hidden');
    })
  );
</script>
