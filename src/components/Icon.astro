---
export type IconId = 'instagram' | 'telegram';

import { url } from '../url';

const { id, width = 24, height = 24, ...rest } = Astro.props as { id: IconId; width?: number; height?: number };
---

<svg xmlns="http://www.w3.org/2000/svg" role="img" aria-hidden="true" {width} {height} {...rest}>
  <use href={url(`/icons.svg#${id}`)}></use>
</svg>
