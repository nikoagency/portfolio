---
import { getTranslations, type Locale } from '../i18n';

const { locale } = Astro.props as { locale: Locale };
const t = getTranslations(locale);
---

<section id="management" class="management-section">
  <div class="container">
    <div class="management-section__header">
      <div class="management-section__title-group">
        <h2 class="management-section__title">{t.management}</h2>
      </div><div class="management-section__description-container">
        <p class="management-section__description">{t.managementLead}</p>
      </div>
    </div>
    <div class="management-section__grid">
      {
        t.managementCards.map(([heading, description], index) => (
          <article class="mgmt-card">
            <>
              <div class="mgmt-card__step">
                {String(index + 1).padStart(2, '0')} / {heading}
              </div>
              <p class="mgmt-card__desc">{description}</p>
            </>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .management-section {
    padding-top: 5rem;
    padding-bottom: 6rem;
    background-color: var(--color-dark);
    color: var(--color-white);
    position: relative;
  }

  .management-section__header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .management-section__title-group {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .management-section__title {
    font-size: var(--fs-3xl);
    font-weight: 300;
    line-height: 1.25;
  }

  .management-section__description {
    color: var(--color-gray-300);
    font-weight: 300;
    line-height: 1.625;
  }

  .management-section__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .mgmt-card {
    padding: 1.5rem;
    background-color: var(--color-dark-surface);
    border: 1px solid var(--color-gray-800);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: border-color var(--transition-fast);
  }

  .mgmt-card:hover {
    border-color: var(--color-gold-alpha-50);
  }

  .mgmt-card__step {
    color: var(--color-gold);
    font-size: var(--fs-lg);
    letter-spacing: 0.1em;
    font-family: var(--font-mono);
  }

  .mgmt-card__title {
    font-size: var(--fs-lg);
    font-family: var(--font-heading);
    font-weight: 400;
  }

  .mgmt-card__desc {
    color: var(--color-gray-300);
    font-weight: 300;
    line-height: 1.625;
  }

  @media (min-width: 640px) {
    .management-section__title {
      font-size: var(--fs-4xl);
    }

    .management-section__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 768px) {
    .management-section__title {
      font-size: var(--fs-5xl);
    }

    .management-section__description {
      font-size: var(--fs-base);
    }
  }

  @media (min-width: 1024px) {
    .management-section__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
