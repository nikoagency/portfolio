---
import { getTranslations, type Locale } from '../i18n';

const { locale, masterWorks } = Astro.props as {
  locale: Locale;
  masterWorks: string[];
};
const t = getTranslations(locale);
---

<section id="master-works" class="container master-works-section">
  <div class="master-works-section__header">
    <div class="master-works-section__info">
      <span class="eyebrow__text">{t.school}</span><h2
        class="master-works-section__title"
      >
        {t.masterWorks}
      </h2><p class="master-works-section__desc">{t.masterLead}</p>
    </div>
  </div><div class="master-works-section__grid">
    {
      masterWorks.map((image, index) => (
        <button
          class="work-card"
          data-lightbox-image={image}
          aria-label={`${t.masterWorks} ${index + 1}`}
        >
          <img
            src={image}
            alt={`${t.masterWorks} ${index + 1}`}
            class="work-card__img"
            loading="lazy"
          />
        </button>
      ))
    }
  </div>
</section>

<style>
  .master-works-section {
    padding-top: 5rem;
    padding-bottom: 6rem;
  }

  .master-works-section__header {
    display: flex;
    flex-direction: column;
    margin-bottom: 4rem;
    gap: 1.5rem;
  }

  .master-works-section__info {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 42rem;
  }

  .master-works-section__title {
    font-size: var(--fs-3xl);
    font-weight: 300;
    color: var(--color-dark);
  }

  .master-works-section__desc {
    color: var(--color-gray-800);
    font-weight: 300;
    line-height: 1.625;
  }

  .master-works-section__count {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-gold);
    font-weight: 600;
  }

  .master-works-section__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .work-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .work-card__img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    display: block;
  }

  .work-card__ph-title {
    font-size: var(--fs-lg);
    font-family: var(--font-heading);
    color: var(--color-dark);
    padding-left: 1rem;
    padding-right: 1rem;
    text-align: center;
  }

  .work-card__ph-tag {
    font-size: var(--fs-10);
    color: var(--color-gray-400);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-top: 0.25rem;
  }

  .work-card__meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 1px solid var(--color-gray-100);
    padding-bottom: 0.5rem;
  }

  .work-card__title {
    font-size: var(--fs-base);
    font-weight: 500;
    color: var(--color-dark);
    transition: color var(--transition-fast);
  }

  .work-card:hover .work-card__title {
    color: var(--color-gold);
  }

  .work-card__badge {
    font-size: var(--fs-11);
    color: var(--color-gray-400);
  }

  .work-card__desc {
    font-size: var(--fs-xs);
    color: var(--color-gray-500);
    font-weight: 300;
  }

  @media (min-width: 640px) {
    .master-works-section__title {
      font-size: var(--fs-4xl);
    }
  }

  @media (min-width: 768px) {
    .master-works-section__header {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }

    .master-works-section__title {
      font-size: var(--fs-5xl);
    }

    .master-works-section__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .master-works-section__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
