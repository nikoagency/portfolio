---
import { type Locale, getTranslations } from '../i18n';
import { url } from '../url';
import Hero from './Hero.astro';
import SkillsSection from './SkillsSection.astro';
import ManagementSection from './ManagementSection.astro';
import SneakersSection from './SneakersSection.astro';
import MasterWorksSection from './MasterWorksSection.astro';
import RestorationSection from './RestorationSection.astro';
import Lightbox from './Lightbox.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';

const { locale } = Astro.props as { locale: Locale };
const t = getTranslations(locale);
const ownWorks = Array.from({ length: 5 }, (_, index) =>
  url(`/img/my-works/photo_${index + 1}_2026-09-22_07-57-33.avif`)
);
const masterWorks = Array.from({ length: 16 }, (_, index) =>
  url(`/img/master-works/photo_${index + 1}_2026-09-22_08-31-27.avif`)
);
const groups = [
  ['bags', 1, 5],
  ['bags', 2, 5],
  ['bags', 3, 7],
  ['bags', 4, 4],
  ['shoes', 1, 5],
  ['shoes', 2, 4],
  ['shoes', 3, 4],
  ['shoes', 4, 2],
] as const;
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={t.role} />
    <title>{t.title}</title>
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    <link rel="stylesheet" href="/portfolio/index.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin="anonymous"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header locale={locale} />

    <main>
      <Hero locale={locale} />
      <SkillsSection locale={locale} />
      <ManagementSection locale={locale} />
      <SneakersSection locale={locale} ownWorks={ownWorks} />
      <MasterWorksSection locale={locale} masterWorks={masterWorks} />
      <RestorationSection locale={locale} groups={groups} />
    </main>

    <Footer locale={locale} />
    <Lightbox locale={locale} />

    <script is:inline>
      document.querySelectorAll('.gallery').forEach((gallery) => {
        const track = gallery.querySelector('.gallery__track');
        const dots = gallery.querySelectorAll('.gallery__dot');
        function updateDots() {
          const slideWidth = track.clientWidth;
          const scrollLeft = track.scrollLeft;
          const activeIndex = Math.round(scrollLeft / slideWidth);
          dots.forEach((dot, i) => {
            dot.classList.toggle('gallery__dot--active', i === activeIndex);
          });
        }
        gallery
          .querySelector('.gallery__btn--prev')
          ?.addEventListener('click', () => {
            track.scrollBy({ left: -track.clientWidth, behavior: 'smooth' });
          });
        gallery
          .querySelector('.gallery__btn--next')
          ?.addEventListener('click', () => {
            track.scrollBy({ left: track.clientWidth, behavior: 'smooth' });
          });
        dots.forEach((dot) => {
          dot.addEventListener('click', () => {
            const index = parseInt(dot.dataset.dot);
            track.scrollTo({
              left: index * track.clientWidth,
              behavior: 'smooth',
            });
          });
        });
        track.addEventListener('scroll', updateDots);
        updateDots();
      });
    </script>
  </body>
</html>
