---
import { locales, type Locale, getTranslations } from '../i18n';
import { url } from '../url';
import Hero from './Hero.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Logo from './Logo.astro';
import SkillsSection from './SkillsSection.astro';
import ManagementSection from './ManagementSection.astro';
import SneakersSection from './SneakersSection.astro';
import MasterWorksSection from './MasterWorksSection.astro';
import RestorationSection from './RestorationSection.astro';
import Lightbox from './Lightbox.astro';
import Footer from './Footer.astro';

const { locale } = Astro.props as { locale: Locale };
const t = getTranslations(locale);
const instagram =
  'https://www.instagram.com/koko_recovery?stkn=MWVoanUxcmNqZGQwZg%3D%3D&utm_source=qr';
const ownWorks = Array.from({ length: 5 }, (_, index) =>
  url(`/img/my-works/photo_${index + 1}_2026-09-22_07-57-33.avif`)
);
const masterWorks = Array.from({ length: 16 }, (_, index) =>
  url(`/img/master-works/photo_${index + 1}_2026-09-22_08-31-27.avif`)
);
const groups = [
  ['bags', 1, 5],
  ['bags', 2, 5],
  ['bags', 3, 7],
  ['bags', 4, 4],
  ['shoes', 1, 5],
  ['shoes', 2, 4],
  ['shoes', 3, 4],
  ['shoes', 4, 2],
] as const;
const navLinks = ['skills', 'management', 'sneakers', 'restoration'];
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={t.role} />
    <title>{t.title}</title>
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    <link rel="stylesheet" href="/portfolio/index.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin="anonymous"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="header">
      <div class="container header__inner">
        <Logo locale={locale} />
        <nav class="nav-desktop" aria-label={t.navigation}>
          {
            navLinks.map((id, index) => (
              <a href={`#${id}`} class="nav-desktop__link gold-hover-link">
                {t.nav[index]}
              </a>
            ))
          }
        </nav>
        <!-- <div class="header__actions">
          <a
            href={instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="header__instagram">@koko_recovery</a>
        </div> -->
        <LanguageSwitcher locale={locale} />
        <button
          class="header__mobile-toggle"
          aria-label={t.menu}
          aria-expanded="false"
          data-menu-button
        >
          <svg
            class="header__mobile-icon"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M4 6h16M4 12h16M4 18h16"></path></svg
          >
        </button>
      </div>
      <div class="mobile-menu hidden" data-mobile-menu>
        <div class="mobile-menu__nav">
          {
            navLinks.map((id, index) => (
              <a href={`#${id}`} class="mobile-menu__link">
                {t.nav[index]}
              </a>
            ))
          }
        </div>
        <div class="mobile-menu__footer">
          <a
            href={instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="mobile-menu__instagram">Instagram @koko_recovery</a
          >
        </div>
      </div>
    </header>

    <main>
      <Hero locale={locale} />
      <SkillsSection locale={locale} />
      <ManagementSection locale={locale} />
      <SneakersSection locale={locale} ownWorks={ownWorks} />
      <MasterWorksSection locale={locale} masterWorks={masterWorks} />
      <RestorationSection locale={locale} groups={groups} />
    </main>
    <Footer locale={locale} />
    <Lightbox locale={locale} />
    <script is:inline>
      const menuButton = document.querySelector('[data-menu-button]');
      const mobileMenu = document.querySelector('[data-mobile-menu]');
      menuButton?.addEventListener('click', () => {
        const open = mobileMenu.classList.toggle('hidden') === false;
        menuButton.setAttribute('aria-expanded', String(open));
      });
      mobileMenu
        ?.querySelectorAll('a')
        .forEach((link) =>
          link.addEventListener('click', () =>
            mobileMenu.classList.add('hidden')
          )
        );
      document.querySelectorAll('.gallery').forEach((gallery) => {
        const track = gallery.querySelector('.gallery__track');
        gallery
          .querySelector('.gallery__btn--prev')
          ?.addEventListener('click', () =>
            track.scrollBy({ left: -track.clientWidth, behavior: 'smooth' })
          );
        gallery
          .querySelector('.gallery__btn--next')
          ?.addEventListener('click', () =>
            track.scrollBy({ left: track.clientWidth, behavior: 'smooth' })
          );
      });
    </script>
  </body>
</html>
