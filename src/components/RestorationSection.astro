---
import { getTranslations, type Locale } from '../i18n';
import { url } from '../url';

const { locale, groups } = Astro.props as {
  locale: Locale;
  groups: readonly (readonly [string, number, number])[];
};
const t = getTranslations(locale);
---

<section id="restoration" class="restoration-section">
  <div class="container">
    <div class="restoration-section__header">
      <div class="restoration-section__info">
        <h2 class="restoration-section__title">{t.restoration}</h2><p
          class="restoration-section__desc"
        >
          {t.restorationLead}
        </p>
      </div>
    </div><ul class="restoration__services-list">
      {
        t.restorationServices.map((service) => (
          <li class="restoration__service-item">
            <>
              <span class="restoration__service-icon">✦</span>
              <span>{service}</span>
            </>
          </li>
        ))
      }
    </ul>
    {
      ['bags', 'shoes'].map((kind) => (
        <Fragment>
          <>
            <h3 class="restoration__group-title">
              {kind === 'bags' ? t.bags : t.shoes}
            </h3>
            <div class="restoration__showcase-grid">
              {groups
                .filter(([group]) => group === kind)
                .map(([, set, total]) => (
                  <div class="gallery">
                    <div class="gallery__slider">
                      <button
                        class="gallery__btn gallery__btn--prev"
                        aria-label={t.previous}
                      >
                        ‹
                      </button>
                      <div class="gallery__track">
                        {Array.from({ length: total }, (_, index) => (
                          <button
                            class="gallery__slide"
                            data-lightbox-image={url(`/img/restoration/${kind}/${set}/${index + 1}.avif`)}
                            aria-label={`${kind} ${set}, ${index + 1}`}
                          >
                            <img
                              src={url(`/img/restoration/${kind}/${set}/${index + 1}.avif`)}
                              alt={kind === 'bags' ? t.bags : t.shoes}
                              loading="lazy"
                            />
                          </button>
                        ))}
                      </div>
                      <button
                        class="gallery__btn gallery__btn--next"
                        aria-label={t.next}
                      >
                        ›
                      </button>
                    </div>
                  </div>
                ))}
            </div>
          </>
        </Fragment>
      ))
    }
  </div>
</section>

<style>
  .restoration-section {
    padding-top: 5rem;
    padding-bottom: 6rem;
    background-color: var(--color-sand);
    border-top: 1px solid var(--color-gray-200);
  }

  .restoration-section__header {
    margin-bottom: 3rem;
  }

  .restoration-section__info {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 42rem;
  }

  .restoration-section__title {
    font-size: var(--fs-3xl);
    font-weight: 300;
    color: var(--color-dark);
    line-height: 1.25;
  }

  .restoration-section__desc {
    color: var(--color-gray-800);
    font-weight: 300;
    line-height: 1.625;
  }

  .restoration__services-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem;
    list-style: none;
    margin-bottom: 4rem;
    padding: 1.5rem;
    background-color: var(--color-white);
    border: 1px solid var(--color-gray-200);
  }

  .restoration__service-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    color: var(--color-gray-800);
    font-weight: 300;
    line-height: 1.5;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--color-gray-200-alpha-60);
  }

  .restoration__service-item:last-child {
    border-bottom: none;
  }

  .restoration__service-icon {
    color: var(--color-gold);
    font-size: var(--fs-xs);
    flex-shrink: 0;
    margin-top: 0.25rem;
  }

  .restoration__group-title {
    font-size: var(--fs-3xl);
    text-align: center;
    font-weight: 400;
    color: var(--color-dark);
    margin-bottom: 1.5rem;
    font-family: var(--font-heading);
  }

  .restoration__showcase-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-bottom: 4rem;
  }

  .restoration__showcase-grid:last-child {
    margin-bottom: 0;
  }

  .gallery {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .gallery__slider {
    position: relative;
    display: flex;
    align-items: center;
  }

  .gallery__track {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 0.5rem 0;
    width: 100%;
  }

  .gallery__track::-webkit-scrollbar {
    display: none;
  }

  .gallery__slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid var(--color-gray-200);
    transition: border-color var(--transition-fast);
  }

  .gallery__slide:hover {
    border-color: var(--color-gold);
  }

  .gallery__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--transition-slow);
  }

  .gallery__slide:hover img {
    transform: scale(1.05);
  }

  .gallery__btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.75);
    border: 1px solid var(--color-gray-200);
    color: var(--color-dark);
    font-size: var(--fs-xl);
    cursor: pointer;
    transition: all var(--transition-fast);
    line-height: 1;
    border-radius: 50%;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .gallery__btn:hover {
    background-color: rgba(197, 160, 89, 0.8);
    border-color: var(--color-gold);
    color: var(--color-white);
  }

  .gallery__btn--prev {
    left: 0.75rem;
  }

  .gallery__btn--next {
    right: 0.75rem;
  }

  @media (max-width: 639px) {
    .gallery__btn {
      display: none;
    }
  }

  .gallery__dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1rem;
    flex-wrap: wrap;
  }

  .gallery__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background-color: var(--color-gray-300);
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background-color var(--transition-fast);
  }

  .gallery__dot:hover {
    background-color: var(--color-gold-alpha-50);
  }

  .gallery__dot--active {
    background-color: var(--color-gold);
    cursor: default;
  }

  @media (min-width: 640px) {
    .restoration-section__title {
      font-size: var(--fs-4xl);
    }

    .restoration__services-list {
      grid-template-columns: repeat(2, 1fr);
    }

    .restoration__showcase-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .restoration-section__title {
      font-size: var(--fs-5xl);
    }

    .restoration__showcase-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
